{
    "version": "2.0.0",
    "options": {
        "shell": {
            "executable": "cmd.exe",
            "args": ["/d", "/c"]
        }
    },
    "tasks": [
        {
            "label": "USD: Check current file",
            "type": "shell",
            "command": "tools\\check.cmd",
            "args": ["${file}"],
            "problemMatcher": [],
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "USD: Check all",
            "type": "shell",
            "command": "tools\\check.cmd",
            "problemMatcher": [],
            "group": "test"
        },
        {
            "label": "USD: View current file (usdview)",
            "type": "shell",
            "command": "tools\\view.cmd",
            "args": ["${file}"],
            "problemMatcher": [],
            "presentation": { "reveal": "silent" }
        },
        {
            "label": "USD: Render current file",
            "type": "shell",
            "command": "tools\\render.cmd",
            "args": ["${file}"],
            "problemMatcher": []
        },
        {
            "label": "USD: Flatten current file (usdcat)",
            "type": "shell",
            "command": "tools\\usd.cmd",
            "args": ["usdcat", "--flatten", "${file}"],
            "problemMatcher": []
        }
    ]
}
