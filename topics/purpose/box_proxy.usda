#usda 1.0
(
    doc = """purpose と proxyPrim で、重いモデル (render) に軽い代役 (proxy) を付ける。
usdview: Display > Display Purposes で切り替えて確認する。"""
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Cube "Box"
    {
        # 本番用。最終レンダリングで表示される
        double size = 2
        color3f[] primvars:displayColor = [(0.8, 0.3, 0.2)]
        uniform token purpose = "render"
        # 「自分の代役はこれ」という対応付け（描画には影響しない）
        rel proxyPrim = </World/BoxProxy>
    }

    def Capsule "BoxProxy"
    {
        # 作業用の代役。全高 = height + radius * 2 = 2 で Box と揃える
        double radius = 0.8
        double height = 0.4
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
        uniform token purpose = "proxy"
    }

    def Sphere "Ball"
    {
        # purpose 未指定 (= "default") は常に表示される
        double radius = 1
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
