#usda 1.0
(
    doc = """Mesh を頂点と面のリストから手書きした四角錐。"""
    defaultPrim = "Pyramid"
    upAxis = "Y"
    metersPerUnit = 1
)

def Mesh "Pyramid"
{
    point3f[] points = [
        (-1, 0, -1), (1, 0, -1), (1, 0, 1), (-1, 0, 1),  # 底面 0〜3
        (0, 1.5, 0)                                      # 頂点 4
    ]
    int[] faceVertexCounts = [4, 3, 3, 3, 3]             # 各面の頂点数
    int[] faceVertexIndices = [
        0, 1, 2, 3,                                      # 底面
        3, 2, 4,  2, 1, 4,  1, 0, 4,  0, 3, 4            # 側面
    ]
    float3[] extent = [(-1, 0, -1), (1, 1.5, 1)]
    uniform token subdivisionScheme = "none"
}
