#usda 1.0
(
    doc = """usda の基本要素をひととおり含んだサンプル。
レイヤーメタデータ / プリム / プリムメタデータ / 属性 / リレーションシップ / timeSamples。"""
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
    startTimeCode = 0
    endTimeCode = 24
)

# コメントは # から行末まで

def Xform "World" (
    doc = "プリムメタデータ: 名前のあとの ( ) に書く"
)
{
    def Sphere "Ball"
    {
        # 属性: [uniform] 型 名前 = 値
        double radius = 1

        # uniform は「時間で変化しない」属性
        uniform token purpose = "default"

        # custom はスキーマに無い自分用の属性
        custom string memo = "自由に追加した属性"

        # timeSamples: フレームごとの値（間は線形補間）
        double3 xformOp:translate.timeSamples = {
            0: (0, 0, 0),
            24: (4, 0, 0),
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cube "Box"
    {
        double size = 1
        # リレーションシップ: 値ではなく別のプリムへのパスを持つ
        rel proxyPrim = </World/Ball>
    }

    # 型なしプリム: 中身を整理するための入れ物
    def "Group"
    {
    }
}
