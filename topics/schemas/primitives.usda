#usda 1.0
(
    doc = """UsdGeom の基本形状を横に並べたもの。
左から Cube, Sphere, Cylinder, Cone, Capsule, Plane。"""
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Cube "Cube"
    {
        double size = 2
        color3f[] primvars:displayColor = [(0.8, 0.3, 0.2)]
        double3 xformOp:translate = (-7.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Sphere "Sphere"
    {
        double radius = 1
        color3f[] primvars:displayColor = [(0.9, 0.6, 0.2)]
        double3 xformOp:translate = (-4.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "Cylinder"
    {
        double radius = 1
        double height = 2
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.8, 0.8, 0.2)]
        double3 xformOp:translate = (-1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "Cone"
    {
        double radius = 1
        double height = 2
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.3, 0.7, 0.3)]
        double3 xformOp:translate = (1.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Capsule "Capsule"
    {
        # 全高 = height + radius * 2
        double radius = 0.7
        double height = 0.6
        uniform token axis = "Y"
        color3f[] primvars:displayColor = [(0.2, 0.5, 0.8)]
        double3 xformOp:translate = (4.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Plane "Plane"
    {
        # axis は面の法線方向。"Z" だと XY 平面（カメラ正面向き）になる
        double width = 2
        double length = 2
        uniform token axis = "Z"
        color3f[] primvars:displayColor = [(0.6, 0.3, 0.8)]
        double3 xformOp:translate = (7.5, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
