#usda 1.0
(
    doc = """同じ translate と rotateZ でも xformOpOrder の順番で結果が変わる。
点には「リストの後ろの op から順に」適用される。"""
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    def Cube "RotateThenTranslate"
    {
        # 回転してから移動 → (3, 0, 0) の位置でその場で 45° 回転
        double size = 1
        color3f[] primvars:displayColor = [(0.8, 0.3, 0.2)]
        double3 xformOp:translate = (3, 0, 0)
        float xformOp:rotateZ = 45
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }

    def Cube "TranslateThenRotate"
    {
        # 移動してから回転 → 原点を中心に 45° 回り込んで (2.12, 2.12, 0) へ
        double size = 1
        color3f[] primvars:displayColor = [(0.2, 0.4, 0.8)]
        double3 xformOp:translate = (3, 0, 0)
        float xformOp:rotateZ = 45
        uniform token[] xformOpOrder = ["xformOp:rotateZ", "xformOp:translate"]
    }

    def Sphere "Origin"
    {
        # 比較用: 原点の目印
        double radius = 0.2
        color3f[] primvars:displayColor = [(0.2, 0.8, 0.2)]
    }
}
