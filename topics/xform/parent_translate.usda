#usda 1.0
(
    doc = """親 Xform を動かすと子もまとめて動く。
子の translate は親からの相対位置。"""
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World"
{
    # World ごと x 方向に 2 動かす
    double3 xformOp:translate = (2, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Cube "Box"
    {
        # ローカル (0, 0, 0) → ワールド (2, 0, 0)
        double size = 2
        color3f[] primvars:displayColor = [(0.8, 0.3, 0.2)]
    }

    def Sphere "Ball"
    {
        # ローカル (3, 0, 0) → ワールド (5, 0, 0)
        double radius = 1
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Sphere "Origin"
{
    # 比較用: ワールド原点の目印
    double radius = 0.2
    color3f[] primvars:displayColor = [(0.2, 0.8, 0.2)]
}
